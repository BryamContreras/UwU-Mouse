<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:allowBackup="false" android:label="UwU Mouse · prueba de latencia"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <activity android:name=".ProbeActivity" android:exported="true"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|smallestScreenSize|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service android:name=".ProbeAccessibilityService" android:exported="true"
            android:label="UwU Mouse · medición temporal"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter><action android:name="android.accessibilityservice.AccessibilityService" /></intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/probe_accessibility" />
        </service>
        <provider android:name=".ProbeControlProvider" android:exported="true"
            android:permission="android.permission.DUMP"
            android:authorities="dev.mobimapper.latencyprobe.control" />
    </application>
</manifest>
